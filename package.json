{
  "name": "reflex-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "반응속도 5회 측정과 서버 SQLite 랭킹",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:cloudflare": "npx wrangler@4 dev",
    "db:create": "npx wrangler@4 d1 create reflex-lab-db",
    "db:migrate": "npx wrangler@4 d1 migrations apply DB --remote",
    "deploy": "npx wrangler@4 deploy",
    "setup:deploy": "node deploy.mjs"
  }
}
